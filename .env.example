# ============================================================================
# trades-ai environment template — copy to .env and fill in what you need.
# NOTHING in this file is a real credential. Never commit your real .env.
# ============================================================================

# --- Solari (required for --live mode; not needed for --mock) ----------------
# Get a key at https://console.getsolari.com  (starts with slr_live_...)
SOLARI_API_KEY=
# Defaults to https://api.getsolari.com — only change if Solari tells you to.
SOLARI_BASE_URL=https://api.getsolari.com
# Optional region pin, e.g. us-west
SOLARI_REGION=
# Stealth browser stack (stealth + managed residential proxy + captcha
# solving) for supplier price-checks. Needs a PAID Solari plan — leave unset
# (or 0) on the free plan, where Solari returns HTTP 402 for stealth.
SOLARI_STEALTH=

# --- Slack notifications (optional) -----------------------------------------
# Incoming-webhook URL for your ops channel:
#   Slack app -> Incoming Webhooks -> Add to channel -> copy URL
SLACK_WEBHOOK_URL=

# --- Gmail (optional) ---------------------------------------------------------
# Ingest: the mailbox that receives work-order emails (IMAP).
# Deliver: the mailbox that sends customer confirmations (SMTP).
# Use a Gmail *app password*, not your login password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where work-order emails arrive from (subject filter is in config/dispatch.yaml)
DISPATCH_INGEST_SENDER=
# Where customer confirmation emails are sent FROM (usually = GMAIL_USER)
DISPATCH_REPLY_FROM=

# --- Quo (virtual phone system) SMS (optional, stub) --------------------------
# https://www.quo.com  — API key + the Quo number texts are sent from.
QUO_API_KEY=
QUO_FROM_NUMBER=

# --- Optional LLM key ---------------------------------------------------------
# Only used if you wire an LLM into the parse step (see docs/adapter-guide.md).
# The shipped parser is deterministic and needs no LLM.
LLM_API_KEY=
